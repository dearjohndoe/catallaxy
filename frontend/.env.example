# VITE_SOL_CLUSTER=devnet
# VITE_SOL_RPC_URL=https://api.devnet.solana.com
# Registry wallet: devnet has a default; mainnet stays off until this is set.
# VITE_SOL_REGISTRY_ADDRESS=

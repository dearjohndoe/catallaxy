# REGISTRY_ADDRESS is hardcoded in src/config.ts — not configurable here.
VITE_TESTNET=true
VITE_RATINGS_BACKEND=
VITE_SSL_GATEWAY=https://catallaxy.cc
VITE_MIN_RATING_TXS=1
